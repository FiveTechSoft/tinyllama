    base = float(pair[0])
    exponent = int(pair[1])
    decimal_value = base * (10 ** exponent)

    # Step 11:  Round the decimal value to 2 decimal places.
    rounded_value = round(decimal_value, 2)

    # Step 12:  Print the rounded decimal value.
    print("{:.2f}".format(rounded_value))
