# Step 11:  Iterate through each CSS statement and update the dictionary with the latest values based on priority.
for _ in range(n):
# Step 12:  Parse the CSS statement values.
	
	(id, attr, val, priority) = map(int, input().split())
	
# Step 13:  Create a key as a tuple (id, attr) to store values in the dictionary.
	
	key = (id, attr)
	
# Step 14:  Check if the key is present in the dictionary.
	
	if key not in css.keys():
# Step 15:  If the key is not present, add the key-value pair to the dictionary.
		
		css[key] = [val, priority]
	else:
# Step 16:  If the key is present, check the priority to update the value accordingly.
		
		x = css[key][1]
		if priority >= x:
# Step 17:  Update the value in the dictionary based on priority.
			
			css[key] = [val, priority]

# Step 18:  Iterate through each query and retrieve the final value from the dictionary based on the object ID and attribute.
for _ in range(m):
# Step 19:  Parse the query values.
	
	(id, attr) = map(int, input().split())
	
# Step 20:  Create a key as a tuple (id, attr) to retrieve the value from the dictionary.
	
	key = (id, attr)
	
# Step 21:  Print the final value for the given object ID and attribute from the dictionary.
	
	print(css[key][0])

