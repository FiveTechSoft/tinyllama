    for _ in range(Q):
        n = int(input("Enter the number of binary strings: "))
        S = [input() for _ in range(n)]
        if all_even(S):
            no_ones = sum(s.count('1') for s in S)
            if no_ones % 2 == 1:
                print(n - 1)
                continue
        print(n)

max_palindromic_strings()

