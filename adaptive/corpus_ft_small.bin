# Step 6: Create a list to store the keys of the circular keyboard.
funky = ['C', 'c', 'D', 'd', 'E', 'F', 'f', 'G', 'g', 'A', 'B', 'S']
# Step 7: Get the number of test cases as input.
T = int(input())
# Step 8: Iterate through each test case.
