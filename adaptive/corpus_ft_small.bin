    cin >> top_base;
    cout << "Enter the length of the bottom base: ";
    cin >> bottom_base;
    cout << "Enter the height: ";
    cin >> height;

    // Receive user input for top_base, bottom_base, and height using cin

    // Calculate the area
    area = (top_base + bottom_base) * height / 2.0;

    // Calculate the area using the formula for trapezoid area: 
    // A = (top_base + bottom_base) * height / 2
    // where A is the area, top_base and bottom_base are the lengths of the top and bottom bases, 
