for i in range(t):
    # Step 8: Get the musical keys of the triad for the current test case as input.
    
    a, b, c = input().split()
    # Step 9: Calculate the semitone gaps between the keys using the position mapping on the circular keyboard.
    
    d1 = dct[b] - dct[a]
    d2 = dct[c] - dct[b]
    # Step 10: Adjust the semitone gaps if they are negative (due to circular layout of the keyboard).
    
    if d1 < 0:
        d1 += 12
    if d2 < 0:
        d2 += 12
    # Step 11: Compare the semitone gaps to determine whether it forms a major or minor triad and output the result for each test case.
    
    if d1 == 3 and d2 == 4:
        print('Minor')
    else:
        print('Major')```
