# Step 5: Define a dictionary to store the mapping of the keys to their positions on the circular keyboard.
dct = {'C': 0, 'c': 1, 'D': 2, 'd': 3, 'E': 4, 'F': 5, 'f': 6, 'G': 7, 'g': 8, 'A': 9, 'B': 10, 'S': 11}
# Step 6: Get the number of test cases as input.
t = int(input())
