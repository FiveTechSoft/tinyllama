Step 4:  We may need to use additional functions to simplify rational numbers and check if they are irreducible.
Step 5:  Let's create a plan to implement the solution based on these thoughts.
```python
# Step 6:  Define a function to find the greatest common divisor (GCD) of two numbers using Euclidean algorithm.
def gcd(a, b):
    if b == 0:
        return a
    else:
        return gcd(b, a % b)

# Step 7:  Define a function to simplify the rational number x/y by dividing both the numerator and the denominator by their greatest common divisor.
def simplify_rational(x, y):
    d = gcd(x, y)
    x = x // d
    y = y // d
    return x, y

# Step 8:  Define a function to solve the problem.
def solve_problem(p, n):
    # Step 9:  Calculate the square root of p
    root_p = p ** 0.5  
    # Step 10:  Initialize the rational number x/y to the minimum value
    x, y = 1, 1  
    # Step 11:  Initialize the rational number u/v to the minimum value
    u, v = 1, 1  
    
    # Step 12:  Iterate through all possible rational numbers in Qn
    
    for i in range(1, n + 1):
        for j in range(1, n + 1):
            # Step 13:  Calculate the value of the rational number i/j and its value compared to the square root of p
            
            value = i / j
            if value < root_p:
                # Step 14:  If the value is less than the square root of p, update the rational number u/v
                
                if value > u / v:
                    u, v = i, j
            else:
                # Step 15:  If the value is greater than or equal to the square root of p, update the rational number x/y
                
                if x / y == 1:
                    x, y = i, j
                elif value < x / y:
                    x, y = i, j
                    break
    
    # Step 16:  Simplify the rational numbers x/y and u/v
    
    x, y = simplify_rational(x, y)
    u, v = simplify_rational(u, v)
    
    # Step 17:  Output the simplified rational numbers x/y and u/v
    
    return f"{x}/{y} {u}/{v}"

# Step 18:  Read input, process it, and call the function to solve the problem
while True:
    p, n = map(int, input().split())
    if p == 0 and n == 0:
        break
    print(solve_problem(p, n))

```
