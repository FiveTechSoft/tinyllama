    # Step 11:  Determine the current priority for the attribute of the object.
    
    cur_priority = priority_mp[id, attr]
    # Step 12:  Check if the new priority is higher than the current priority and update mapping and priority if needed.
    
    if priority >= cur_priority:
        priority_mp[id, attr] = priority
        mp_attr[id, attr] = val

# Step 13:  Process each query and print the corresponding final value of the attribute for the object.
for _ in range(m):
    # Step 14:  Read the id and attribute from input.
    
    (id, attr) = map(int, input().split())
    # Step 15:  Print the final value of the specified attribute for the object.
    
    print(mp_attr[id, attr])

