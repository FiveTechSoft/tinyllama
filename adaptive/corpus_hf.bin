Rewrite the following code in python:: ```
#include <vector>
#include <iostream>

using namespace std;

const int MAX_CHAR = 26;

struct TrieNode {
    vector<TrieNode*> children;
    bool isEnd;

    TrieNode() : children(MAX_CHAR, nullptr), isEnd(false) {}
};

class Trie {
public:
    Trie() {
        root = new TrieNode();
    }

    void insert(string word) {
        TrieNode* currNode = root;
        for (char c : word) {
            int index = c - 'a';
            if (currNode->children[index] == nullptr) {
                currNode->children[index] = new TrieNode();
            }
            currNode = currNode->children[index];
        }
        currNode->isEnd = true;
    }

    bool search(string word) {
        TrieNode* currNode = root;
        for (char c : word) {
            int index = c - 'a';
            if (currNode->children[index] == nullptr) {
                return false;
            }
            currNode = currNode->children[index];
        }
        return currNode->isEnd;
    }

    bool startsWith(string prefix) {
        TrieNode* currNode = root;
        for (char c : prefix) {
            int index = c - 'a';
            if (currNode->children[index] == nullptr) {
                return false;
            }
            currNode = currNode->children[index];
        }
        return true;
    }

private:
    TrieNode* root;
};
``````
class TrieNode:
    def __init__(self):
        self.children = [None] * 26
        self.isEnd = False

class Trie:
    def __init__(self):
        self.root = TrieNode()

    def insert(self, word: str) -> None:
        curr_node = self.root
        for letter in word:
            index = ord(letter) - ord('a')
            if not curr_node.children[index]:
                curr_node.children[index] = TrieNode()
            curr_node = curr_node.children[index]
        curr_node.isEnd = True

    def search(self, word: str) -> bool:
        curr_node = self.root
        for letter in word:
            index = ord(letter) - ord('a')
            if not curr_node.children[index]:
                return False
            curr_node = curr_node.children[index]
        return curr_node.isEnd

    def startsWith(self, prefix: str) -> bool:
        curr_node = self.root
        for letter in prefix:
            index = ord(letter) - ord('a')
            if not curr_node.children[index]:
                return False
            curr_node = curr_node.children[index]
        return True
```
