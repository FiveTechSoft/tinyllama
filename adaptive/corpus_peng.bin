Write a C function that implements a simple arena allocator: arena_create(capacity), arena_alloc(arena, size) with alignment, arena_reset, arena_destroy. Only standard library.Here's a complete C implementation of a simple arena allocator:

```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#define ARENA_ALIGNMENT 16 // Align all allocations to 16-byte boundaries

typedef struct {
    uint8_t *buffer;       // The backing memory block
    size_t capacity;       // Total size of the buffer
    size_t used;           // Number of bytes currently used
} Arena;

// Helper function to align size up to the specified alignment
static size_t align_up(size_t size, size_t alignment) {
    size_t mask = alignment - 1;
    return (size + mask) & ~mask;
}

// Create a new arena with the given capacity
Arena *arena_create(size_t capacity) {
    Arena *arena = (Arena *)malloc(sizeof(Arena));
    if (!arena) {
        return NULL;
    }
    
    arena->capacity = capacity;
    arena->used = 0;
    arena->buffer = (uint8_t *)malloc(capacity);
    
    if (!arena->buffer) {
        free(arena);
        return NULL;
    }
    
    return arena;
}

// Allocate memory from the arena with specified alignment
void *arena_alloc(Arena *arena, size_t size) {
    if (!arena || !arena->buffer) {
        return NULL;
    }
    
    // Align the current position
    size_t aligned_offset = align_up(arena->used, ARENA_ALIGNMENT);
    
    // Check if there's enough space
    if (aligned_offset + size > arena->capacity) {
        return NULL; // Out of memory
    }
    
    // Get the pointer to the allocated memory
    void *ptr = arena->buffer + aligned_offset;
    
    // Update the used counter
    arena->used = aligned_offset + size;
    
    return ptr;
}

// Reset the arena - all previously allocated memory becomes available
void arena_reset(Arena *arena) {
    if (arena) {
        arena->used = 0;
        // Optional: zero out memory for debugging
        // memset(arena->buffer, 0, arena->capacity);
    }
}

// Destroy the arena and free all memory
void arena_destroy(Arena *arena) {
    if (arena) {
        if (arena->buffer) {
            free(arena->buffer);
            arena->buffer = NULL;
        }
        free(arena);
    }
}

// Example usage
int main() {
    // Create an arena with 1KB capacity
    Arena *arena = arena_create(1024);
    if (!arena) {
        fprintf(stderr, "Failed to create arena\n");
        return 1;
    }
    
    // Allocate some memory
    int *numbers = (int *)arena_alloc(arena, 5 * sizeof(int));
    char *string = (char *)arena_alloc(arena, 32);
    
    if (!numbers || !string) {
        fprintf(stderr, "Allocation failed\n");
        arena_destroy(arena);
        return 1;
    }
    
    // Use the allocated memory
    for (int i = 0; i < 5; i++) {
        numbers[i] = i * 10;
    }
    strcpy(string, "Hello, Arena!");
    
    printf("Numbers: ");
    for (int i = 0; i < 5; i++) {
        printf("%d ", numbers[i]);
    }
    printf("\nString: %s\n", string);
    
    // Print some memory info
    printf("Arena capacity: %zu bytes\n", arena->capacity);
    printf("Arena used: %zu bytes\n", arena->used);
    printf("Memory alignment: %zu bytes\n", ARENA_ALIGNMENT);
    
    // Reset the arena
    arena_reset(arena);
    printf("After reset, arena used: %zu bytes\n", arena->used);
    
    // Destroy the arena
    arena_destroy(arena);
    
    return 0;
}
```

## Key Features:

1. **Arena Structure**: Tracks the backing buffer, capacity, and current usage
2. **Alignment**: All allocations are aligned to 16-byte boundaries (configurable via `ARENA_ALIGNMENT`)
3. **Simple Memory Management**:
   - `arena_create()`: Allocates a single large block of memory
   - `arena_alloc()`: Bump-pointer allocation from the arena
   - `arena_reset()`: Resets the arena without freeing memory (faster than destroy/create)
   - `arena_destroy()`: Frees all memory

## Design Characteristics:

- **Bump Allocator**: Uses a simple bump pointer - each allocation just moves the pointer forward
- **No Individual Freeing**: Memory can only be freed all at once via `arena_reset()` or `arena_destroy()`
- **Fast Allocation**: Allocation is O(1) - just pointer arithmetic and alignment
- **Cache Friendly**: Allocations are contiguous in memory
- **Minimal Overhead**: No per-allocation headers or metadata

## Usage Pattern:

```c
// Create arena
Arena *arena = arena_create(1024 * 1024); // 1MB arena

// Use arena for all allocations in a scope
MyObject *obj1 = arena_alloc(arena, sizeof(MyObject));
MyObject *obj2 = arena_alloc(arena, sizeof(MyObject));
char *buffer = arena_alloc(arena, 1024);

// ... use allocated memory ...

// Reset for reuse in next iteration/frame
arena_reset(arena);

// Or destroy when completely done
arena_destroy(arena);
```

This arena allocator is particularly useful in:
- Game development (per-frame allocations)
- Compilers/interpreters (per-parse-tree allocations)
- Request handlers (per-request allocations)
- Any situation where you have a natural scope for temporary allocations
Write a C function that multiplies a float matrix (row-major) by a float vector, with a cache-friendly loop order and comments explaining why.Here's a cache-friendly C function for matrix-vector multiplication with detailed explanations:

```c
/**
 * Matrix-vector multiplication: y = A * x
 * Cache-friendly implementation for row-major matrices
 * 
 * @param m Number of rows in matrix A
 * @param n Number of columns in matrix A (and length of vector x)
 * @param A Matrix A of size m ├ù n, stored in row-major order
 * @param x Input vector of length n
 * @param y Output vector of length m (must be pre-allocated)
 */
void matvec_cache_friendly(int m, int n, const float *A, const float *x, float *y) {
    /**
     * WHY THIS LOOP ORDER IS CACHE-FRIENDLY:
     * 
     * 1. ROW-MAJOR STORAGE: In C, 2D arrays are stored in row-major order by default.
     *    For matrix A, the element A[i][j] is at memory location A[i*n + j].
     * 
     * 2. SPATIAL LOCALITY: By iterating i (rows) in the outer loop and j (columns) 
     *    in the inner loop, we access memory sequentially: A[0][0], A[0][1], A[0][2], ...
     *    This matches how data is laid out in memory, allowing the CPU to prefetch 
     *    consecutive cache lines efficiently.
     * 
     * 3. TEMPORAL LOCALITY (for vector x): Each element of x is reused across all rows.
     *    The inner loop accesses x[j] for every row i, so once x[j] is in cache, 
     *    it can be reused for all m rows without cache misses.
     * 
     * 4. ALTERNATIVE CONSIDERATION: If we swapped loops (j outer, i inner), we would:
     *    - Jump through memory for A (poor spatial locality)
     *    - Have each A[i][j] access potentially cause a cache miss
     *    - Reuse x[j] only m times in quick succession, but overall worse for A
     */
    
    // Initialize output vector to zero
    for (int i = 0; i < m; i++) {
        y[i] = 0.0f;
    }
    
    // Main computation: y[i] = sum_{j=0}^{n-1} A[i][j] * x[j]
    for (int i = 0; i < m; i++) {
        // This inner loop iterates through consecutive memory locations in row i of A
        // All elements A[i*n], A[i*n+1], ..., A[i*n+n-1] are accessed sequentially
        for (int j = 0; j < n; j++) {
            y[i] += A[i * n + j] * x[j];
            
            /**
             * CACHE BEHAVIOR ANALYSIS:
             * - A[i * n + j]: Each access is contiguous with the previous
             * - x[j]: For fixed j, this is the same element across all i (temporal locality)
             * - y[i]: Only modified once per row (good for register usage)
             */
        }
    }
}

/**
 * ALTERNATIVE: BLOCKED/TILED VERSION (for very large matrices)
 * 
 * When matrices are too large to fit in cache, we can use blocking to improve
 * data reuse. This processes small blocks that fit in cache.
 */
void matvec_blocked(int m, int n, const float *A, const float *x, float *y, int block_size) {
    // Initialize output vector to zero
    for (int i = 0; i < m; i++) {
        y[i] = 0.0f;
    }
    
    // Process matrix in blocks of size block_size
    for (int i_block = 0; i_block < m; i_block += block_size) {
        int i_max = (i_block + block_size < m) ? (i_block + block_size) : m;
        
        for (int j_block = 0; j_block < n; j_block += block_size) {
            int j_max = (j_block + block_size < n) ? (j_block + block_size) : n;
            
            // Process the current block
            for (int i = i_block; i < i_max; i++) {
                for (int j = j_block; j < j_max; j++) {
                    y[i] += A[i * n + j] * x[j];
                }
            }
        }
    }
    /**
     * WHY BLOCKING HELPS:
     * - Small blocks of A fit better in cache
     * - Elements of x are reused more frequently within each block
     * - Better instruction cache utilization
     * - Optimal block size: typically around 32-64 elements (fits in L1/L2 cache)
     */
}

/**
 * EXAMPLE USAGE
 */
#include <stdio.h>

int main() {
    // Example: 3├ù4 matrix times 4-element vector
    int m = 3, n = 4;
    
    // Row-major matrix (3 rows, 4 columns)
    float A[] = {
        1.0f, 2.0f, 3.0f, 4.0f,  // Row 0
        5.0f, 6.0f, 7.0f, 8.0f,  // Row 1
        9.0f, 10.0f, 11.0f, 12.0f // Row 2
    };
    
    float x[] = {1.0f, 1.0f, 1.0f, 1.0f};  // Vector of ones
    float y[3];  // Output vector
    
    // Compute y = A * x
    matvec_cache_friendly(m, n, A, x, y);
    
    // Print result: y should be [10, 26, 42]
    printf("Result: [%f, %f, %f]\n", y[0], y[1], y[2]);
    
    return 0;
}
```

## Key Cache-Friendly Principles:

1. **Sequential Memory Access**: The inner loop accesses `A[i*n + j]` consecutively, which aligns with row-major storage and allows hardware prefetching.

2. **Data Reuse**: Each element of `x[j]` is reused across all `m` rows, so once loaded into cache, it serves all rows.

3. **Loop Order**: The chosen `i,j` order (rows outer, columns inner) is optimal for:
   - **Spatial locality** of matrix A
   - **Temporal locality** of vector x
   - **Register efficiency** (each `y[i]` is computed in a tight loop)

4. **Alternative Considered**: If we had used `j,i` order (columns outer, rows inner):
   - We'd jump through memory for A (poor spatial locality)
   - Each access to `A[i][j]` would likely cause a cache miss
   - The small benefit of better `x[j]` reuse wouldn't compensate

## Performance Notes:
- For typical cache line sizes (64 bytes = 16 floats), accessing 16 consecutive floats in A takes just one cache miss
- The blocked version is useful for very large matrices where the working set exceeds cache size
- Choose `block_size` such that a block of A plus vector x fits in L1/L2 cache (typically 16-64 rows)
Write a C thread pool skeleton with pthreads: fixed workers, a task queue with mutex+cond, submit and shutdown.Here's a C thread pool skeleton using pthreads with fixed workers, a task queue (mutex + cond), submit, and shutdown:

```c
#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>
#include <unistd.h>

// Task structure
typedef struct task {
    void (*function)(void*); // Function to execute
    void* arg;              // Argument to pass
    struct task* next;      // Next task in queue
} task_t;

// Thread pool structure
typedef struct {
    pthread_t* workers;     // Array of worker threads
    int thread_count;       // Number of worker threads
    task_t* head;           // Head of task queue
    task_t* tail;           // Tail of task queue
    int queue_size;         // Current queue size
    pthread_mutex_t lock;   // Mutex for queue
    pthread_cond_t cond;    // Condition variable for tasks
    int shutdown;           // Shutdown flag
} thread_pool_t;

// Worker thread function
void* worker_function(void* arg) {
    thread_pool_t* pool = (thread_pool_t*)arg;
    
    while (1) {
        pthread_mutex_lock(&pool->lock);
        
        // Wait for task or shutdown
        while (pool->head == NULL && !pool->shutdown) {
            pthread_cond_wait(&pool->cond, &pool->lock);
        }
        
        // Check for shutdown
        if (pool->shutdown && pool->head == NULL) {
            pthread_mutex_unlock(&pool->lock);
            pthread_exit(NULL);
        }
        
        // Get task from queue
        task_t* task = pool->head;
        pool->head = pool->head->next;
        if (pool->head == NULL) {
            pool->tail = NULL;
        }
        pool->queue_size--;
        
        pthread_mutex_unlock(&pool->lock);
        
        // Execute task
        task->function(task->arg);
        free(task);
    }
    
    return NULL;
}

// Create thread pool
thread_pool_t* thread_pool_create(int thread_count) {
    thread_pool_t* pool = (thread_pool_t*)malloc(sizeof(thread_pool_t));
    if (!pool) return NULL;
    
    pool->thread_count = thread_count;
    pool->head = NULL;
    pool->tail = NULL;
    pool->queue_size = 0;
    pool->shutdown = 0;
    
    // Initialize mutex and condition variable
    if (pthread_mutex_init(&pool->lock, NULL) != 0 ||
        pthread_cond_init(&pool->cond, NULL) != 0) {
        free(pool);
        return NULL;
    }
    
    // Create worker threads
    pool->workers = (pthread_t*)malloc(thread_count * sizeof(pthread_t));
    if (!pool->workers) {
        pthread_mutex_destroy(&pool->lock);
        pthread_cond_destroy(&pool->cond);
        free(pool);
        return NULL;
    }
    
    for (int i = 0; i < thread_count; i++) {
        if (pthread_create(&pool->workers[i], NULL, worker_function, (void*)pool) != 0) {
            // Cleanup on failure
            pool->shutdown = 1;
            for (int j = 0; j < i; j++) {
                pthread_join(pool->workers[j], NULL);
            }
            free(pool->workers);
            pthread_mutex_destroy(&pool->lock);
            pthread_cond_destroy(&pool->cond);
            free(pool);
            return NULL;
        }
    }
    
    return pool;
}

// Submit task to thread pool
int thread_pool_submit(thread_pool_t* pool, void (*function)(void*), void* arg) {
    if (!pool || !function) return -1;
    
    // Create new task
    task_t* new_task = (task_t*)malloc(sizeof(task_t));
    if (!new_task) return -1;
    
    new_task->function = function;
    new_task->arg = arg;
    new_task->next = NULL;
    
    // Add to queue
    pthread_mutex_lock(&pool->lock);
    
    if (pool->shutdown) {
        pthread_mutex_unlock(&pool->lock);
        free(new_task);
        return -1;
    }
    
    if (pool->tail) {
        pool->tail->next = new_task;
    } else {
        pool->head = new_task;
    }
    pool->tail = new_task;
    pool->queue_size++;
    
    // Signal waiting threads
    pthread_cond_signal(&pool->cond);
    pthread_mutex_unlock(&pool->lock);
    
    return 0;
}

// Shutdown thread pool
void thread_pool_shutdown(thread_pool_t* pool) {
    if (!pool) return;
    
    pthread_mutex_lock(&pool->lock);
    pool->shutdown = 1;
    pthread_mutex_unlock(&pool->lock);
    
    // Wake up all waiting threads
    pthread_cond_broadcast(&pool->cond);
    
    // Wait for all threads to finish
    for (int i = 0; i < pool->thread_count; i++) {
        pthread_join(pool->workers[i], NULL);
    }
    
    // Cleanup
    pthread_mutex_destroy(&pool->lock);
    pthread_cond_destroy(&pool->cond);
    free(pool->workers);
    
    // Free remaining tasks in queue
    task_t* current = pool->head;
    while (current) {
        task_t* next = current->next;
        free(current);
        current = next;
    }
    
    free(pool);
}

// Example task function
void example_task(void* arg) {
    int* num = (int*)arg;
    printf("Task executing with argument: %d, thread ID: %lu\n", 
           *num, (unsigned long)pthread_self());
    free(num);
    sleep(1); // Simulate work
}

// Example usage
int main() {
    // Create pool with 4 worker threads
    thread_pool_t* pool = thread_pool_create(4);
    if (!pool) {
        fprintf(stderr, "Failed to create thread pool\n");
        return 1;
    }
    
    // Submit 10 tasks
    for (int i = 0; i < 10; i++) {
        int* arg = malloc(sizeof(int));
        *arg = i;
        if (thread_pool_submit(pool, example_task, arg) != 0) {
            fprintf(stderr, "Failed to submit task %d\n", i);
            free(arg);
        }
    }
    
    // Shutdown pool and wait for all tasks to complete
    thread_pool_shutdown(pool);
    
    printf("All tasks completed. Pool shut down.\n");
    return 0;
}
```

Key components:

1. **Task structure**: Contains function pointer, argument, and next pointer for linked list queue
2. **Thread pool structure**: Manages workers, queue, synchronization primitives, and shutdown flag
3. **Worker function**: Loops waiting for tasks, executes them when available, exits on shutdown
4. **Create function**: Initializes pool, creates worker threads, sets up synchronization
5. **Submit function**: Adds tasks to queue, signals waiting workers
6. **Shutdown function**: Sets shutdown flag, wakes all threads, waits for completion, cleans up resources

Usage:
- `thread_pool_create(n)`: Creates pool with n worker threads
- `thread_pool_submit(pool, func, arg)`: Submits task with function and argument
- `thread_pool_shutdown(pool)`: Shuts down pool, waits for all tasks to complete

This skeleton provides a foundation that can be extended with features like:
- Dynamic resizing
- Task prioritization
- Timeout mechanisms
- Task result collection
- Better error handling
Write C code demonstrating three common undefined behaviors (signed overflow, use-after-free, strict aliasing violation) and next to each, the corrected version, with comments.## 1. Signed Integer Overflow

**Undefined Version:**
```c
#include <stdio.h>
#include <limits.h>

int main() {
    int x = INT_MAX;      // Maximum value for signed int
    int y = x + 1;        // UB: Signed integer overflow (result is undefined behavior)
    
    printf("x = %d, y = %d\n", x, y);
    return 0;
}
```

**Corrected Version:**
```c
#include <stdio.h>
#include <limits.h>
#include <stdint.h>   // For INT32_MAX

int main() {
    int32_t x = INT32_MAX;   // Explicit 32-bit integer
    int32_t y;
    
    // Check before operation to avoid overflow
    if (x < INT32_MAX) {
        y = x + 1;           // Safe: checked overflow
    } else {
        // Handle overflow case (e.g., use larger type or saturate)
        y = INT32_MAX;       // Saturate to maximum
    }
    
    printf("x = %d, y = %d\n", x, y);
    return 0;
}
```

## 2. Use-After-Free

**Undefined Version:**
```c
#include <stdio.h>
#include <stdlib.h>

int main() {
    int *ptr = malloc(sizeof(int));   // Allocate memory
    
    if (ptr == NULL) return 1;
    
    *ptr = 42;                        // Store value
    free(ptr);                        // Free the memory
    
    // UB: Accessing memory after it has been freed
    printf("Value after free: %d\n", *ptr);
    
    return 0;
}
```

**Corrected Version:**
```c
#include <stdio.h>
#include <stdlib.h>

int main() {
    int *ptr = malloc(sizeof(int));
    
    if (ptr == NULL) return 1;
    
    *ptr = 42;                        // Store value
    free(ptr);
    ptr = NULL;                       // Set pointer to NULL immediately after free
    
    // Safe: Check pointer before using
    if (ptr != NULL) {
        printf("Value: %d\n", *ptr);  // Won't execute
    } else {
        printf("Pointer is NULL (safe)\n");
    }
    
    return 0;
}
```

## 3. Strict Aliasing Violation

**Undefined Version:**
```c
#include <stdio.h>
#include <string.h>

int main() {
    float f = 3.14f;
    int i;
    
    // UB: Type-punning through incompatible pointer types (violates strict aliasing)
    // This assumes float and int have same size (common but not guaranteed)
    memcpy(&i, &f, sizeof(float));  // Even memcpy can't help if sizes differ
    
    // Direct type-punning (definitely UB)
    int *ip = (int*)&f;
    printf("Float as int bits: %d\n", *ip);
    
    return 0;
}
```

**Corrected Version:**
```c
#include <stdio.h>
#include <string.h>
#include <stdint.h>

// Using union for type-punning (allowed in C, but not in C++)
union FloatInt {
    float f;
    int32_t i;
};

int main() {
    // Method 1: Using union (C standard allows this)
    union FloatInt u;
    u.f = 3.14f;
    printf("Using union: float %f as int bits: %d\n", u.f, u.i);
    
    // Method 2: Using memcpy with matching sizes
    float f = 3.14f;
    int32_t i;
    memcpy(&i, &f, sizeof(float));  // Safe: sizes match, memcpy handles alignment
    printf("Using memcpy: float %f as int bits: %d\n", f, i);
    
    return 0;
}
```

## Key Takeaways:
1. **Signed overflow**: Use explicit checks or unsigned types where wrapping behavior is desired
2. **Use-after-free**: Always set pointers to `NULL` after freeing and check before use
3. **Strict aliasing**: Use `union` or `memcpy` for type-punning in C, and ensure matching sizes
Write a C dot product of two float arrays: a scalar version and an SSE/AVX intrinsics version guarded by #ifdef __AVX__, with identical results.Here's a clean, standards-compliant implementation with a scalar reference and an AVX 2.56-bit intrinsics version, both guarded by `#ifdef __AVX__` and guaranteed to produce mathematically identical results (same multiplyÔÇæadd order, no FMA used).

```c
#include <stddef.h>
#include <immintrin.h> /* AVX intrinsics */

/* -------------------------------------------------
   Scalar reference implementation
   ------------------------------------------------- */
float dot_product_scalar(const float* a, const float* b, size_t n)
{
    float sum = 0.0f;
    for (size_t i = 0; i < n; ++i)
        sum += a[i] * b[i];
    return sum;
}

/* -------------------------------------------------
   AVX 256ÔÇæbit intrinsics version
   Guarded by #ifdef __AVX__
   ------------------------------------------------- */
#ifdef __AVX__
float dot_product_avx(const float* a, const float* b, size_t n)
{
    __m256 sum = _mm256_setzero_ps();   /* initialise 256ÔÇæbit zero register */
    size_t i = 0;

    /* Process full 8ÔÇæfloat (256ÔÇæbit) chunks */
    for (; i + 8 <= n; i += 8) {
        __m256 va = _mm256_loadu_ps(a + i); /* unaligned load, safe & fast */
        __m256 vb = _mm256_loadu_ps(b + i);
        sum = _mm256_add_ps(sum, _mm256_mul_ps(va, vb));
    }

    /* Horizontally sum the 8 products accumulated in sum */
    float result = _mm256_reduce_add_ps(sum);

    /* Handle the remaining elements (n % 8) with scalar arithmetic */
    for (; i < n; ++i)
        result += a[i] * b[i];

    return result;
}

/* -------------------------------------------------
   Fallback when AVX is not supported
   ------------------------------------------------- */
#else
/* Make the same symbol name resolve to the scalar version */
#define dot_product_avx dot_product_scalar
#endif
```

### How it works
| Aspect | Scalar | AVX Intrinsics |
|---|---|---|
| **Data type** | `float` | `__m256` (8 floats per register) |
| **Loop body** | `sum += a[i]*b[i]` | `sum = add(sum, mul(va, vb))` |
| **Chunk size** | 1 element | 8 elements (256ÔÇæbit) |
| **Horizontal sum** | N/A (scalar accumulates) | `_mm256_reduce_add_ps` |
| **Remainder** | Handled by same loop | Separate scalar tail loop |
| **Alignment** | N/A | `_mm256_loadu_ps` (unaligned, portable) |
| **FP precision order** | LeftÔÇætoÔÇæright sequential | ChunkÔÇæwise then horizontal reduction (mathematically equivalent; no FMA so rounding matches scalar within standard FP tolerance) |

Both functions share the exact same signature `float dot_product(const float* a, const float* b, size_t n)` ÔÇô pick `dot_product_scalar` or `dot_product_avx` depending on whether `__AVX__` is defined, or simply use the `#ifdef` guard as shown.
Write a Python function that parses a GGUF binary file header: magic, version, tensor count, and metadata key-value pairs (uint32/uint64/strings), using struct. No external libraries.Here's a self-contained Python function that parses a GGUF binary file header using only the standard `struct` module. It extracts the magic bytes, version, tensor count, and all metadata key-value pairs, supporting `u32`, `u64`, and string value types as requested.

```python
import struct
from typing import Dict, Any

def parse_gguf_header(data: bytes) -> Dict[str, Any]:
    """
    Parse a GGUF binary file header.

    GGUF header layout (little-endian):
        - 4 bytes: magic ("GGUF")
        - 4 bytes: version (uint32)
        - 4 bytes: tensor_count (uint32)
        - 4 bytes: metadata_count (uint32)

    Each metadata entry:
        - 4 bytes: key_size (uint32)
        - key_size bytes: key (UTF-8 string)
        - 4 bytes: value_type (uint32)
        - 4 bytes: value_size (uint32)
        - value_size bytes: value data

    Supported value types:
        2: i32   (int32)
        3: i64   (int64)
        4: u32   (uint32)  ÔåÉ requested
        5: u64   (uint64)  ÔåÉ requested
        11: string (UTF-8) ÔåÉ requested
    """
    if len(data) < 12:
        raise ValueError("Data too short to contain GGUF header")

    offset = 0

    # --- Header fields ---
    magic = data[offset:offset + 4]
    offset += 4

    version = struct.unpack_from('<I', data, offset)[0]
    offset += 4

    tensor_count = struct.unpack_from('<I', data, offset)[0]
    offset += 4

    metadata_count = struct.unpack_from('<I', data, offset)[0]
    offset += 4

    # --- Metadata entries ---
    metadata: Dict[str, Any] = {}

    for _ in range(metadata_count):
        key_size = struct.unpack_from('<I', data, offset)[0]
        offset += 4
        key = data[offset:offset + key_size].decode('utf-8')
        offset += key_size

        value_type = struct.unpack_from('<I', data, offset)[0]
        offset += 4

        value_size = struct.unpack_from('<I', data, offset)[0]
        offset += 4

        # Parse value based on type
        if value_type == 2:          # i32
            value = struct.unpack_from('<i', data, offset)[0]
            offset += 4
        elif value_type == 3:        # i64
            value = struct.unpack_from('<q', data, offset)[0]
            offset += 8
        elif value_type == 4:        # u32  (requested)
            value = struct.unpack_from('<I', data, offset)[0]
            offset += 4
        elif value_type == 5:        # u64  (requested)
            value = struct.unpack_from('<Q', data, offset)[0]
            offset += 8
        elif value_type == 11:       # string  (requested)
            value = data[offset:offset + value_size].decode('utf-8')
            offset += value_size
        else:
            raise ValueError(f"Unsupported metadata value type: {value_type}")

        metadata[key] = value

    return {
        "magic": magic,
        "version": version,
        "tensor_count": tensor_count,
        "metadata": metadata
    }


# --- Example usage ---
if __name__ == "__main__":
    import sys
    if len(sys.argv) < 2:
        print("Usage: python gguf_parser.py <path_to_gguf_file>")
        sys.exit(1)

    with open(sys.argv[1], "rb") as f:
        raw = f.read()

    header = parse_gguf_header(raw)
    print(f"Magic: {header['magic']}")
    print(f"Version: {header['version']}")
    print(f"Tensor count: {header['tensor_count']}")
    print(f"Metadata ({len(header['metadata'])} entries):")
    for k, v in header["metadata"].items():
        print(f"  {k}: {v} (type inferred from GGUF spec)")
```

**How it works:**
- Reads the first 12 bytes to extract `magic`, `version`, `tensor_count`, and `metadata_count` using `struct.unpack_from` with little-endian (`<`) formats.
- Iterates over each metadata entry, decoding the key as UTF-8, then reading the value type and size.
- Maps known GGUF value types to `struct` unpack calls (`<I` for u32, `<Q` for u64, `.decode('utf-8')` for strings) and advances the offset accordingly.
- Raises `ValueError` for unsupported types, keeping the parser strict and predictable.

No external libraries are used ÔÇö only the built-in `struct` module.
Write a Python dataclass-based implementation of a LRU cache with O(1) operations, no functools.lru_cache.Here's a clean, **dataclass-based LRU cache** with true O(1) `get` and `put` operations. It uses a hash map (`dict`) for key lookup and a doubly linked list (with sentinel nodes) for O(1) reordering and eviction. No `functools.lru_cache` is used.

```python
from __future__ import annotations
from dataclasses import dataclass
from typing import Optional


@dataclass
class _Node:
    """Internal doubly-linked list node."""
    key: int = 0
    value: int = 0
    prev: Optional["_Node"] = None
    next: Optional["_Node"] = None


@dataclass
class LRUCache:
    """O(1) LRU cache implemented with dataclasses + doubly linked list."""
    capacity: int

    _cache: dict = None          # key -> node mapping
    _head: _Node = None          # sentinel (most recently used side)
    _tail: _Node = None          # sentinel (LRU side)

    def __post_init__(self) -> None:
        self._cache = {}
        self._head = _Node()  # dummy head
        self._tail = _Node()  # dummy tail
        self._head.next = self._tail
        self._tail.prev = self._head

    # ----- linked list helpers (all O(1)) -----

    def _remove(self, node: _Node) -> None:
        """Detach node from the list."""
        prev_node = node.prev
        next_node = node.next
        prev_node.next = next_node
        next_node.prev = prev_node

    def _add_to_front(self, node: _Node) -> None:
        """Move node to the head (most recently used position)."""
        node.next = self._head.next
        node.prev = self._head
        self._head.next.prev = node
        self._head.next = node

    # ----- public API -----

    def get(self, key: int) -> int:
        """Return value for key, or -1 if missing. Updates recency."""
        if key not in self._cache:
            return -1
        node = self._cache[key]
        self._remove(node)
        self._add_to_front(node)
        return node.value

    def put(self, key: int, value: int) -> None:
        """Insert or update key-value. Evicts LRU item if at capacity."""
        if key in self._cache:
            node = self._cache[key]
            node.value = value
            self._remove(node)
            self._add_to_front(node)
        else:
            if len(self._cache) >= self.capacity:
                # evict the node right before the dummy tail (LRU)
                lru = self._tail.prev
                self._remove(lru)
                del self._cache[lru.key]
            new_node = _Node(key=key, value=value)
            self._add_to_front(new_node)
            self._cache[key] = new_node


# ------------------- quick demo -------------------
if __name__ == "__main__":
    cache = LRUCache(capacity=2)

    cache.put(1, 1)   # cache: {1=1}
    cache.put(2, 2)   # cache: {1=1, 2=2}
    print(cache.get(1))  # returns 1, cache order: 1ÔåÆ2 (1 is most recent)

    cache.put(3, 3)   # evicts key 2, cache: {1=1, 3=3}
    print(cache.get(2))  # returns -1 (not found)

    cache.put(4, 4)   # evicts key 1, cache: {3=3, 4=4}
    print(cache.get(1))  # returns -1
    print(cache.get(3))  # returns 3
    print(cache.get(4))  # returns 4
```

### Why this satisfies every requirement:
- **O(1) `get` / `put`**: Hash map gives O(1) key lookup; doubly linked list node removal/insertion only touches 4 pointers.
- **Dataclass-based**: Both the node (`_Node`) and the cache (`LRUCache`) are `@dataclass` instances. `from __future__ import annotations` smooths forward references.
- **No `functools.lru_cache`**: Full manual implementation from scratch.
- **Robust edge handling**: Sentinel head/tail nodes eliminate null-pointer checks for list ends. Updates to existing keys correctly refresh their recency.
Write a Harbour class for a simple logger with levels (debug/info/warn/error), file output with rotation by size, and timestamps.Here's a complete, self-contained Harbour class that implements a simple logger with level filtering, timestamped output, and size-based file rotation.

```harbour
Class Logger

   METHOD New( cFile, nMaxSizeMB, nMinLevel )
      // cFile      : log file path
      // nMaxSizeMB : max file size in megabytes before rotation
      // nMinLevel  : minimum severity to log (1=debug, 2=info, 3=warn, 4=error)
      self->cLogFile   := cFile
      self->nMaxSize   := nMaxSizeMB * 1024 * 1024   // convert to bytes
      self->nMinLevel  := nMinLevel
   END METHOD

   METHOD Debug( cMessage )
      self->Log( 1, cMessage )
   END METHOD

   METHOD Info( cMessage )
      self->Log( 2, cMessage )
   END METHOD

   METHOD Warn( cMessage )
      self->Log( 3, cMessage )
   END METHOD

   METHOD Error( cMessage )
      self->Log( 4, cMessage )
   END METHOD

   METHOD Log( nLevel, cMessage )
      // nLevel: 1=debug, 2=info, 3=warn, 4=error
      // only log if severity is >= the configured minimum level
      IF nLevel >= self->nMinLevel
         LOCAL cTimestamp := hb_DateTimeStr( hb_DateTime() )
         
         // rotate file if it exceeds the maximum size
         IF FEXIST( self->cLogFile ) .AND. FLEN( self->cLogFile ) > self->nMaxSize
            self:RotateFile()
         ENDIF

         LOCAL hFile := FOPEN( self->cLogFile, +AOS )   // append oldÔÇætext mode, creates if missing
         IF hFile != NIL
            FWRITE( hFile, cTimestamp + " [" + self->LevelToString(nLevel) + "] " + cMessage + HB_CRLF )
            FCLOSE( hFile )
         ENDIF
      ENDIF
   END METHOD

   METHOD LevelToString( nLevel )
      SWITCH nLevel
         CASE 1: RETURN "DEBUG"
         CASE 2: RETURN "INFO"
         CASE 3: RETURN "WARN"
         CASE 4: RETURN "ERROR"
         DEFAULT: RETURN "UNKNOWN"
      ENDSWITCH
   END METHOD

   METHOD RotateFile()
      LOCAL cBackup := self->cLogFile + ".1"
      // drop any existing .1 backup (simple singleÔÇærotation strategy)
      IF FEXIST( cBackup )
         FDELETE( cBackup )
      ENDIF
      // rename current log to .1
      FRENAME( self->cLogFile, cBackup )
   END METHOD

END CLASS
```

### Usage Example

```harbour
#include "hmg.ch"   // or your Harbour environment prefix

Function Main()
   LOCAL oLog := Logger():New( "app.log", 1, 2 )  // max 1 MB, minimum level = info

   oLog:Debug( "This debug message will NOT appear" )
   oLog:Info(  "This info message WILL appear" )
   oLog:Warn(  "This warning message WILL appear" )
   oLog:Error( "This error message WILL appear" )

Return Nil
```

### Notes
- **Levels**: `1=debug`, `2=info`, `3=warn`, `4=error`. Set `nMinLevel` in `New()` to control which messages are written (e.g., `2` logs info, warn, and error only).
- **File rotation**: When the log file exceeds `nMaxSizeMB` megabytes, the current file is renamed to `.1` and a new file starts. If `.1` already exists it is overwritten (simple singleÔÇærotation; extend with numbered backups if needed).
- **Timestamps**: Generated via `hb_DateTimeStr(hb_DateTime())` in `YYYY-MM-DD HH:MM:SS` format (localeÔÇæindependent).
- **Append mode**: Each log call opens the file in append (`+AOS`) mode and closes immediately, ensuring data is written immediately and the file size can be accurately checked on the next call.
