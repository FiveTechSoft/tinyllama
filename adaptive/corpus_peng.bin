   /// Reads an 8-byte little-endian unsigned 64-bit integer from `buf` starting at `offset`.
   /// Returns `Err(ParseError::NotEnoughBytes)` if the slice is too short.
   pub fn read_u64_le(buf: &[u8], offset: usize) -> Result<u64, ParseError> {
       if offset + 8 > buf.len() {
           return Err(ParseError::NotEnoughBytes);
       }
       let mut bytes = [0u8; 8];
       bytes.copy_from_slice(&buf[offset..offset + 8]);
       Ok(u64::from_le_bytes(bytes))
