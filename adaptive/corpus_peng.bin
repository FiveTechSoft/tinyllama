               return Ok((result, i));
           }
           // Guard against excessively long varints (more than 10 bytes for u64)
           if i - offset > 10 {
               return Err(ParseError::VarintTooLong);
           }
       }
       // Loop ended without encountering a termination byte -> truncated varint
       Err(ParseError::TruncatedVarint)
   }

